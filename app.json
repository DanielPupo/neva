      "package": "com.neva.snow"
    },
    "plugins": [
      [
        "expo-sensors",
        {
          "motionPermission": "Permita ao NEVA usar os movimentos do celular para controlar o snowboard."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6a606778-d208-41d3-8eea-a37504fc4b0b"
      }
    },
    "owner": "pupoo"
  }
}
